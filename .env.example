# Template for .env — copy to `.env` (gitignored). Vite reads this file too, so be aware which vars
# are VITE_-prefixed (bundled into the client) vs not.
#
#   cp .env.example .env
#
# The VITE_* vars below are read live at build/dev-server-start time by Vite — that's what `pnpm dev`
# and `docker compose up` (dev target) use, so changing them takes effect on the next start, no rebuild
# needed. They're also the fallback src/config.ts reads if window.__AGORA__ is unset. The published
# `prod` Docker image does NOT need any of this baked in: its nginx entrypoint
# (docker-entrypoint.d/40-agora-config.sh) rewrites the equivalent AGORA_DEMO_* CONTAINER env into
# /config.js at runtime instead — each var below notes its AGORA_DEMO_* prod runtime override.

# AGORA_UMAMI_API_KEY — a true secret. NOT VITE_-prefixed, so Vite never exposes it to the client
#   bundle. Server-side Umami *reporting* key (stats read-back); the browser tracker never needs it.
#   Name matches the agora-server env var (env.AGORA_UMAMI_API_KEY). No AGORA_DEMO_* runtime override —
#   this one is never read by the browser bundle, so there's nothing for window.__AGORA__ to carry.
AGORA_UMAMI_API_KEY=your-umami-reporting-api-key-here

# The @agora SDK reads VITE_API_BASE_URL via getApiBaseUrl(). Runtime override: AGORA_DEMO_API_BASE_URL
VITE_API_BASE_URL=http://localhost:4000/v7
# Runtime override: AGORA_DEMO_PROJECT_ID
VITE_PROJECT_ID=11111111-1111-1111-1111-111111111111

# Seeded demo user (see agora-server/apps/api/scripts/seed-demo-user.mjs) — login is prefilled from
# these. Runtime overrides: AGORA_DEMO_EMAIL / AGORA_DEMO_PASSWORD
VITE_DEMO_EMAIL=your-demo-user@example.com
VITE_DEMO_PASSWORD=your-demo-admin-password-here

# Optional: link to the separate admin app (header button shows only for operator tokens); leave unset
# to hide it. Runtime override: AGORA_DEMO_ADMIN_URL
VITE_ADMIN_URL=

# Umami tracker (browser side): the self-hosted host + website id. Leaving either empty disables
# analytics (a clean no-op, not an error). Runtime overrides: AGORA_DEMO_UMAMI_URL / AGORA_DEMO_UMAMI_ID
VITE_AGORA_UMAMI_URL=
VITE_AGORA_UMAMI_DEMO_ID=

# VITE_AGORA_SECURE_CHAT_DEBUG — toggles the secure-chat SDK's trace/debug logging (off by default).
#   Must be VITE_-prefixed so it reaches the browser bundle: the SDK's own AGORA_SECURE_CHAT_DEBUG /
#   process.env path is Node-only and never fires in a Vite browser build, so App.tsx reads this var
#   and calls setSecureChatDebug() at import time. Values:
#     "" / "false" / "0" / "off"  → silent (default)
#     "debug"                      → digestible status lines (method/url/status, seq, decrypt outcome)
#     "true" / "1" / "trace"       → everything, incl. full raw payload dumps
#   ⚠️ Dev aid only — when on it prints plaintext-adjacent material with no redaction. Keep off in prod.
#   Runtime override: AGORA_DEMO_SECURE_CHAT_DEBUG
VITE_AGORA_SECURE_CHAT_DEBUG=false
