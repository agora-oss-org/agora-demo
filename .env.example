# Template for .env — copy to `.env` (gitignored). Vite reads this file too, so be aware which vars
# are VITE_-prefixed (bundled into the client) vs not.
#
#   cp .env.example .env
#
# Two sections below, and the split is deliberate:
#
#   1. VITE_* — read LIVE by Vite at dev-server-start (`pnpm dev`, `docker compose up` dev target).
#      Changing these takes effect on the next start, no rebuild. Fine to leave blank/placeholder —
#      `dev` is a live process, never the thing that actually gets published.
#
#   2. AGORA_DEMO_* — read by the PUBLISHED `prod` image's nginx entrypoint
#      (docker-entrypoint.d/40-agora-config.sh) at CONTAINER START, and written into /config.js
#      (window.__AGORA__), which src/config.ts reads before ever falling back to a baked VITE_* value.
#
# THE POINT of that split: `vite build` inlines VITE_* as literal strings into the static JS bundle
# FOREVER — there's no process left afterward to re-read an env var. So real values must never be
# passed as VITE_* Docker build-args (that's baking sensitive-shaped info directly into a public
# image); they belong in AGORA_DEMO_*, supplied as actual container env vars at deploy time.

# AGORA_UMAMI_API_KEY — a true secret. NOT VITE_-prefixed, so Vite never exposes it to the client
#   bundle. Server-side Umami *reporting* key (stats read-back); the browser tracker never needs it.
#   Name matches the agora-server env var (env.AGORA_UMAMI_API_KEY). No AGORA_DEMO_* runtime override —
#   this one is never read by the browser bundle, so there's nothing for window.__AGORA__ to carry.
AGORA_UMAMI_API_KEY=your-umami-reporting-api-key-here

# === VITE_* — local `pnpm dev` / docker compose (dev target) only. Never baked into the published
# image, so leaving these blank is fine; the AGORA_DEMO_* section below is what actually matters for
# anything deployed. ===
VITE_API_BASE_URL=http://localhost:4000/v7
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
VITE_ADMIN_URL=
VITE_AGORA_UMAMI_URL=
VITE_AGORA_UMAMI_DEMO_ID=

# VITE_AGORA_EMAIL_REDIRECT_TO — origin the Agora server stamps into sign-up / password-reset /
#   verification-email links (@agora-sdk/core's emailRedirectTo, divergence #6). Leave blank for
#   local dev: the SDK falls back to window.location.origin, which is already correct for whatever
#   localhost port you're on. Only needed to override that fallback (e.g. a path-prefixed mount).
VITE_AGORA_EMAIL_REDIRECT_TO=

# VITE_AGORA_SECURE_CHAT_DEBUG — toggles the secure-chat SDK's trace/debug logging (off by default).
#   Must be VITE_-prefixed so it reaches the browser bundle: the SDK's own AGORA_SECURE_CHAT_DEBUG /
#   process.env path is Node-only and never fires in a Vite browser build, so App.tsx reads this var
#   and calls setSecureChatDebug() at import time. Values:
#     "" / "false" / "0" / "off"  → silent (default)
#     "debug"                      → digestible status lines (method/url/status, seq, decrypt outcome)
#     "true" / "1" / "trace"       → everything, incl. full raw payload dumps
#   ⚠️ Dev aid only — when on it prints plaintext-adjacent material with no redaction. Keep off in prod.
VITE_AGORA_SECURE_CHAT_DEBUG=false

# === AGORA_DEMO_* — read by the prod image's nginx entrypoint at container start; this is what
# actually configures a deployed/public image. Set real values here (for local docker-compose testing
# of the prod target) or as real container env vars at actual deploy time — NEVER as a Docker
# build-arg. No AGORA_DEMO_PROJECT_ID here: src/config.ts now falls back to the well-known demo
# project id in code, so it's only needed if you're pointing at a different project. ===
AGORA_DEMO_API_BASE_URL=http://localhost:4000/v7
AGORA_DEMO_EMAIL=your-demo-user@example.com
AGORA_DEMO_PASSWORD=your-demo-admin-password-here
AGORA_DEMO_ADMIN_URL=
AGORA_DEMO_SECURE_CHAT_DEBUG=false
AGORA_DEMO_UMAMI_URL=
AGORA_DEMO_UMAMI_ID=
# Blank here defaults to the public demo's own origin (https://demo.agora-oss.org) in the entrypoint
# script; override for a self-hosted deployment so its own confirmation/reset emails land back on it.
AGORA_DEMO_EMAIL_REDIRECT_TO=
