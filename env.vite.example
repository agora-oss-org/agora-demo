# Template for env.vite — copy to `env.vite` (gitignored) and adjust. These are CLIENT vars: Vite
# loads them (vite.config.ts → process.loadEnvFile) and inlines VITE_* into the browser bundle, so
# never put real secrets here (the Umami reporting key goes in .env, un-prefixed).
#
#   cp env.vite.example env.vite
#
# The @agora SDK reads VITE_API_BASE_URL via getApiBaseUrl(). Point at a local server for dev, or the
# deployed one (https://agora.recoverysky.net/v7) to test against prod.
VITE_API_BASE_URL=http://localhost:4000/v7
VITE_PROJECT_ID=11111111-1111-1111-1111-111111111111
# Seeded demo user (see agora/server/scripts/seed-demo-user.mjs) — login is prefilled from these.
VITE_DEMO_EMAIL=agora-demo@gmail.com
# Optional: link to the separate admin app (header button shows only for operator tokens).
VITE_ADMIN_URL=http://localhost:5173/

# Umami tracker (browser side): the self-hosted host, the website id, and the hostname it reports
# under. NOT the reporting API key — that's a server secret and lives in .env.
VITE_AGORA_UMAMI_URL=https://your-umami-host.example.com/umami
VITE_AGORA_UMAMI_DEMO_ID=00000000-0000-0000-0000-000000000000
VITE_AGORA_UMAMI_HOSTNAME=demo.example.com
